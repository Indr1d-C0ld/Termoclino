{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "rootDirs": [
      "./web/assets",
      "./"
    ]
  },
  "include": [
    "shared/**/*.js",
    "server/src/**/*.js",
    "web/assets/js/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules"
  ]
}
